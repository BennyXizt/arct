<%
// Пример вызова в шаблоне (EJS):
//
// <\%- include('externe/components/content/Counter/Counter.ejs', { 
// 	counter_component: {
// 		this: {
// 			parent: 'parentClass',
// 			block: 'childBlockClass',
// 			class: ['childClass'],
// 			tag: 'article',
// 			style: ['customStyle'],
// 			dataAttribute: ['customDataAttributes'], 
// 		},
// 		wrapper: {
// 			parent: 'wrapperParentClass',
// 			block: 'wrapperChildBlockClass',
// 			class: ['wrapperChildClass'],
// 			id: ['wrapperChildID'],
// 			tag: 'div',
// 			style: ['customStyle'],
// 			dataAttribute: ['customDataAttributes'], 
// 		},
// 		value: '150' || {start: '0', end: '150'}
// 	}
// }) %>
%>
<%
	if(typeof counter_component === 'undefined' || !counter_component) {
		return
	}

	counter_component.this = {
		...counter_component.this,
		tag: counter_component.this?.tag ? counter_component.this?.tag : 'span'
	}

	var {blockClass, thisClass, thisID, thisTag, thisStyles, thisDataAttributes} = externe.setupEJSComponent({...counter_component.this, componentName: 'counter'})
	var {isWrapper, blockClass: wrapperBlockClass, thisClass: wrapperThisClass, thisID: wrapperThisID, thisTag: wrapperThisTag, thisStyles: wrapperThisStyles, thisDataAttributes: wrapperThisDataAttributes} = externe.setupEJSComponent({...counter_component.wrapper, componentName: 'counter'})
	
	var isWrapper = typeof counter_component.wrapper === 'object' && counter_component.wrapper

	if(typeof counter_component.value !== 'undefined' && counter_component.value) {
		thisDataAttributes += ` data-fsc-counter`

		if(typeof counter_component.value.end !== 'undefined' && counter_component.value.end) {
			finalvalue = counter_component.value.end

			thisDataAttributes += ` data-fsc-counter-finalvalue=${finalvalue}`
			thisStyles = `style='width: ${finalvalue.toString().length}ch'`
		} else {
			finalvalue = counter_component.value
			
			thisDataAttributes += ` data-fsc-counter-finalvalue=${finalvalue}`
			thisStyles = `style='width: ${finalvalue.toString().length}ch'`
		}
	}

	var startValue = 0
	if(
		(typeof counter_component.value !== 'undefined' && counter_component.value) &&
		(typeof counter_component.value.start !== 'undefined' && counter_component.value.start)
	) {
		startValue = counter_component.value.start
	}
%>

<% if(isWrapper) { %>
	<<%=wrapperThisTag%> <%-wrapperThisDataAttributes%> class='<%=wrapperThisClass%>' <%-wrapperThisID%> <%-wrapperThisStyles%>>
<% } %>
<<%=thisTag%> class='<%=thisClass%>' <%-thisStyles%> <%-thisDataAttributes%>>
	<%=startValue%>
</<%=thisTag%>>
<% if(isWrapper) { %>
	</<%=wrapperThisTag%>>
<% } %>
<%
//   Компонент <marquee>: карусель изображений с поддержкой бесшовного скролла (marquee)
//   Использует <ul> и <li> для структуры слайдов и подключает компонент <Image> для каждого элемента
  
//   Основные особенности:
//   1. marquee_component.block — имя блока для модификации CSS-классов (по умолчанию 'marquee')
//   2. marquee_component.images — массив объектов изображений, каждый объект должен содержать атрибуты для <Image>:
//      - src, alt, width, height, loading, decoding, srcset и type
//   3. Внутренний <ul class="marquee__inner"> получает атрибут data-fsc-marquee для инициализации скролла
//   4. Каждый <li class="marquee__item"> содержит один компонент <Image> с переданными параметрами
  
//   Пример использования компонента:
// <\%- include('externe/components/content/Marquee/Marquee.ejs', {
//     marquee_component: {
//         this: {
//             component: 'component',
//             parent: 'parentClass',
//             block: 'childBlockClass',
//             class: ['childClass'],
//             id: ['childID'],
//             tag: 'div',
//             style: ['customStyle'],
//             dataAttribute: ['customDataAttributes'], 
//         },
//         images: [
//             {
//             src: 'src',
//             alt: 'alt',
//             width: 600,
//             height: 400,
//             loading: 'lazy',
//             decoding: 'async'
//             }
//         ],
//         data: [
//             'someText'
//         ]
//     }
// }) %>
%>

<% 
    if(typeof marquee_component === 'undefined' || !marquee_component) {
        return
    }

    marquee_component.this = {
        ...marquee_component.this,
        tag: marquee_component.this?.tag ? marquee_component.this?.tag : 'article',
        dataAttribute: [
            'data-fsc-marquee',
            ...marquee_component.this.dataAttribute,
        ]
    }

    var {blockClass, thisClass, thisID, thisTag, thisStyles, thisDataAttributes} = externe.setupEJSComponent({...marquee_component.this, componentName: 'marquee'})

    isDouble = false

    if(typeof marquee_component.type !== 'undefined' && marquee_component.type) {
        if(marquee_component.type === 'double') {
            isDouble = true

            thisDataAttributes += ' data-fsc-marquee-type=double'
        }
    }
%>

<<%=thisTag%> class='<%=thisClass%>' <%-thisDataAttributes%> <%-thisStyles%>>
    <% if(Array.isArray(marquee_component.content)) { %>
        <% if(isDouble) { %>
            <div class="<%=blockClass%>__wrapper" data-fsc-marquee-wrapper>
        <% } %>

        <ul class="<%=blockClass%>__list" data-fsc-marquee-list>
        
            <% for(const content of marquee_component.content) { %>
                <li class="<%=blockClass%>__item" data-fsc-marquee-item>
                    <%-content%>
                </li>
            <% } %>
        
        </ul>

        <% if(isDouble) { %>
            </div>
        <% } %>
        
    <% } %>
</<%=thisTag%>>
<section class='layout__<%=blockClass%> <%=blockClass%>' id="about">
	<div class='<%=blockClass%>__container container'>
		<div class="<%=blockClass%>__container-inner container-inner">
			<%- include('src/ejs/components/title.ejs', {
				title_component: {
					this: {
						parent: blockClass,
					},
					title: {
						tag: 'h2',
						label: 'about me'
					},
					// subititle: ''
				}
			})%>
			<div class="<%=blockClass%>__content">
				<div class="<%=blockClass%>__bigtext">
					<%= about_component.text.bigtext %>
				</div>
				<div class="<%=blockClass%>__text text">
					<% for(var text of about_component.text.p) { %>
						<p>
							<%= text %>
						</p>
					<% } %>
				</div>
				

				<%- include('src/ejs/components/button.ejs', {
					button_component: about_component.button_component
				}) %>
			</div>
		</div>
	</div>
</section>
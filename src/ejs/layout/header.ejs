<% 
	var pages = [
		{
            'href': '#home',
            'anchor': 'Home',
            'dataAttribute': [
                'data-fsc-scrollto',
                'data-fsc-scrollto-to="main > *:first-child"'
            ]
        },
		{
            'href': '#about',
            'anchor': 'About',
            'dataAttribute': [
                'data-fsc-scrollto',
                'data-fsc-scrollto-dynamic',
            ]
        },
		{
            'href': '#services',
            'anchor': 'Services',
            'dataAttribute': [
                'data-fsc-scrollto',
                'data-fsc-scrollto-dynamic',
            ]
        },
		{
            'href': '#portfolio',
            'anchor': 'Portfolio',
            'dataAttribute': [
                'data-fsc-scrollto',
                'data-fsc-scrollto-dynamic',
            ]
        },
		{
            'href': '#contact',
            'anchor': 'Contact',
            'dataAttribute': [
                'data-fsc-scrollto',
                'data-fsc-scrollto-dynamic',
            ]
        },
	]

    var thisDataAttributes = [
        'data-fsc-scroll',
        'data-fsc-scroll-trigger=down',
    ]
%>
<header class="header" <%=thisDataAttributes.join(' ')%> >
    <div class="header__container container">
        <%- include('externe/components/menu/Logo/Logo.ejs', {
            logo_component: {
                this: {
                    parent: 'header'
                },
                wrapper: {
                    parent: 'header'
                },
                homePage: header_component.homePage,
                icon_component: {
                    this: {
                        parent: 'logo'
                    },
                    name: "logo"
                },
                label: 'arct'
            }
        })%>
        <div class="header__body">
            <%- include('src/ejs/components/headerMenu.ejs', {
                header_menu_component: {
                    list: pages,
                    activePage: header_component.activePage ?? ''
                }
            }) %>

            <%- include('externe/components/menu/ThemeToggle/ThemeToggle.ejs', {
                theme_toggle_component: {}
            })%>
            
            <%- include('externe/components/menu/Burger/Burger.ejs', {
                burger_component: {
                    this: {
                        parent: 'header',
                    }
                }
            })%>

            
        </div>
    </div>
</header>